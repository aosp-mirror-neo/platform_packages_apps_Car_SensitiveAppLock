<resources>
    <!--  Dummy style so that overlays can be applied without removing dynamic styling  -->
    <style name="PinPadKeyOverlayable" parent="Widget.CarUi.Button" />

    <style name="PinPadKey" parent="PinPadKeyOverlayable">
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/pin_pad_key_text_size</item>
        <item name="layout_constraintHeight">@dimen/pin_pad_key_height_default</item>
        <item name="layout_constraintWidth">0dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:padding">@dimen/pin_pad_digit_key_padding</item>
        <item name="layout_constraintWidth_max">@dimen/pin_pad_key_max_width</item>
        <item name="layout_constraintWidth_min">@dimen/pin_pad_key_min_width</item>
    </style>

    <style name="PinPadKey.ActionButton" parent="PinPadKey">
        <item name="android:padding">@dimen/pin_pad_action_key_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">?android:attr/textColorPrimary</item>
    </style>
</resources>
