<resources>
  <string name="app_name">Sensitive App Lock</string>

  <string name="setting_title">App lock</string>
  <string name="setting_summary">Lock apps to stop other people opening them</string>

  <string name="app_lock_switch">Use app lock</string>
  <string name="app_lock_switch_summary">Keep some apps locked with a pin</string>
  <string name="protected_apps_category">My apps</string>

  <string name="legal_notice_summary">
    Unlocked apps might still use data from your locked apps. For example, a social media app might upload photos or files from a locked app.\n\nAnyone that installs a new app that shares an account with a locked app, like a messaging app linked to your social media account, may be automatically signed in. This could potentially expose your data in the car.
  </string>

  <string name="validate_pin_title">Enter your PIN</string>
  <string name="create_pin_title">Set a PIN for locked apps</string>
  <string name="create_pin_subtitle">PIN must be at least 4 digits</string>
  <string name="confirm_pin_title">Confirm your app PIN</string>
  <string name="confirm_pin_subtitle">Enter your PIN again</string>

  <string name="suspend_dialog_title">You’re unlocking apps you protected</string>
  <string name="suspend_dialog_message">Make sure you’re comfortable with others in the car seeing any private content in these apps</string>
  <string name="suspend_dialog_neutral_button_text">Unlock now</string>

  <string name="pin_error">Wrong PIN</string>

  <string name="pin_screen_next_button_label">Next</string>

  <string name="pin_screen_recovery_label">Forgot your PIN?</string>

  <!-- Digits on the PIN pad -->
  <string name="one">1</string>
  <string name="two">2</string>
  <string name="three">3</string>
  <string name="four">4</string>
  <string name="five">5</string>
  <string name="six">6</string>
  <string name="seven">7</string>
  <string name="eight">8</string>
  <string name="nine">9</string>
  <string name="zero">0</string>

  <string name="backspace_key_content_description">Backspace</string>
  <string name="confirm_key_content_description">Confirm</string>

  <!-- Sign In dialog -->
  <string name="signin_dialog_title">In case you forget your PIN</string>
  <string name="signin_dialog_message">Sign in with your account to securely reset your PIN if you forget it</string>
  <string name="signin_dialog_neutral_button_text">No thanks</string>
  <string name="signin_dialog_positive_button_text">Sign in</string>

  <!-- Pin Reset Dialog -->
  <string name="reset_dialog_title">Security reset required</string>
  <string name="reset_dialog_message">No recovery method was set up. To keep your data safe, resetting your PIN requires you to uninstall all protected apps first.</string>
  <string name="reset_dialog_downloaded_apps">Uninstall the following apps</string>
  <string name="reset_dialog_preinstalled_apps">For system apps you cannot uninstall, clear their data by selecting the App > Storage &amp; Cache > Clear storage</string>
  <string name="reset_dialog_neutral_button_text">Got it</string>
  <string name="reset_dialog_reset_now_title">Reset Now</string>
  <string name="reset_dialog_reset_now_message">You can now reset your pin.</string>
  <string name="reset_dialog_positive_button_text">Reset</string>

  <!-- Guest Users -->
  <string name="guest_user_exit_toast_message">App lock isn\'t available in guest profile.</string>

</resources>
