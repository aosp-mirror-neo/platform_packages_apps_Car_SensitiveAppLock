    <string name="signin_dialog_title" msgid="2602183663691051856">"PIN կոդը փոխելն ավելի հեշտ կլինի"</string>
    <string name="signin_dialog_message" msgid="7841819688654397929">"Մուտք գործեք ձեր Google հաշիվ, որպեսզի անվտանգ կերպով փոխեք ձեր PIN կոդը, եթե մոռանաք այն"</string>
    <string name="signin_dialog_neutral_button_text" msgid="347433123745607147">"Ոչ, շնորհակալություն"</string>
    <string name="signin_dialog_positive_button_text" msgid="6467865472033924831">"Մուտք գործել"</string>
    <string name="reset_dialog_title" msgid="3911707407002097606">"Մոռացե՞լ եք ձեր PIN կոդը"</string>
    <string name="reset_dialog_message" msgid="737252557931508514">"Ձեր PIN կոդը փոխելու և ձեր տեղեկությունների անվտանգությունն ապահովելու համար ջնջեք ձեր կողպած հավելվածները կամ դրանցում պահված տվյալները"</string>
