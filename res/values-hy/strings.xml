    <string name="app_name" msgid="3145012753431925035">"Զգայուն տեղեկություններ պարունակող հավելվածների կողպում"</string>
    <string name="setting_title" msgid="7121031924096985436">"Հավելվածների կողպում"</string>
    <string name="setting_summary" msgid="6570520942958337147">"Կողպեք հավելվածները, որպեսզի ոչ ոք չկարողանա դրանք բացել"</string>
    <string name="app_lock_switch" msgid="7624924448599158727">"Օգտագործել հավելվածների կողպումը"</string>
    <string name="app_lock_switch_summary" msgid="8490918503325573267">"Կողպել որոշ հավելվածներ PIN կոդով"</string>
    <string name="protected_apps_category" msgid="1304801071926013713">"Իմ հավելվածները"</string>
    <string name="legal_notice_summary" msgid="964477552334840080">"Հավելվածի կողպումը անջատում է միայն օգտատիրական ինտերֆեյսը: Հավելվածը կարող է շարունակել աշխատել ֆոնային ռեժիմում և փոխանակել տվյալներ (օրինակ՝ լուսանկարներ կամ ֆայլեր) այլ հավելվածների հետ։ Բացի այդ՝ ցանկացած մեկը, ով տեղադրում է նոր հավելված, որն օգտագործում է նույն հաշիվը, ինչ կողպված հավելվածը, կարող է ավտոմատ մուտք գործել այնտեղ և, հավանաբար, նաև ստանալ մեքենայի ձեր տվյալների հասանելիություն։"</string>
    <string name="validate_pin_title" msgid="2053218844267207153">"Մուտքագրեք PIN կոդը"</string>
    <string name="create_pin_title" msgid="1990451669307401708">"Ստեղծեք PIN կոդ կողպված հավելվածների համար"</string>
    <string name="create_pin_subtitle" msgid="345370787765861031">"PIN կոդը պետք է առնվազն 4 թիվ պարունակի"</string>
    <string name="confirm_pin_title" msgid="4009110544654814981">"Հաստատեք ձեր PIN կոդը"</string>
    <string name="confirm_pin_subtitle" msgid="1153589606464182760">"Նորից մուտքագրեք PIN կոդը"</string>
    <string name="suspend_dialog_title" msgid="1457226327210092792">"«%1$s» հավելվածը կողպված է"</string>
    <string name="suspend_dialog_message" msgid="5286023807180986910">"Ընտրեք "<b>"Ապակողպել հավելվածը"</b>"՝ ձեր PIN կոդը մուտքագրելու համար, եթե դեմ չեք, որ մեքենայում գտնվող մարդիկ տեսնեն ձեր տեղեկությունները"</string>
    <string name="suspend_dialog_neutral_button_text" msgid="4271520468647846177">"Ապակողպել հավելվածը"</string>
