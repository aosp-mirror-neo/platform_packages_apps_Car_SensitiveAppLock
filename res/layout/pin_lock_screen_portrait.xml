<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/entered_pin"
        android:textSize="@dimen/pin_lock_screen_title_text_size"
        tools:text="Title"
        android:layout_marginTop="@dimen/pin_lock_screen_title_margin" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pin_lock_screen_subtitle_margin"
        android:textSize="@dimen/pin_lock_screen_subtitle_text_size"
        tools:text="Subtitle" />

    <EditText
        android:id="@+id/entered_pin"
        android:layout_width="352dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/pin_lock_screen_entered_pin_margin"
        android:autofillHints=""
        android:clickable="false"
        android:contextClickable="false"
        android:cursorVisible="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:inputType="numberPassword"
        tools:text="1234"
        android:gravity="bottom|center_horizontal" />

    <com.android.car.sensitiveapplock.lockscreen.PinPadView
        android:id="@+id/pin_pad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pin_lock_screen_pin_pad_margin" />

    <TextView
        android:id="@+id/button_recovery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pin_lock_screen_recovery_button_margin"
        android:text="@string/pin_screen_recovery_label"
        android:textSize="28sp"
        android:visibility="gone" />
</LinearLayout>
