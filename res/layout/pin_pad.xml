<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <GridLayout
        android:id="@+id/grid_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pin_pad_col_spacing"
        android:layout_marginEnd="@dimen/pin_pad_col_spacing"
        android:layout_marginTop="@dimen/pin_pad_row_spacing_default"
        android:layout_marginBottom="@dimen/pin_pad_row_spacing_default"
        android:columnCount="3">
        <!--  Row 1  -->
        <TextView
            android:id="@+id/key_1"
            style="@style/PinPadKey"
            android:text="@string/one" />

        <TextView
            android:id="@+id/key_2"
            style="@style/PinPadKey"
            android:text="@string/two" />

        <TextView
            android:id="@+id/key_3"
            style="@style/PinPadKey"
            android:text="@string/three" />
        <!--  Row 2  -->
        <TextView
            android:id="@+id/key_4"
            style="@style/PinPadKey"
            android:text="@string/four" />

        <TextView
            android:id="@+id/key_5"
            style="@style/PinPadKey"
            android:text="@string/five" />

        <TextView
            android:id="@+id/key_6"
            style="@style/PinPadKey"
            android:text="@string/six" />
        <!--  Row 3  -->
        <TextView
            android:id="@+id/key_7"
            style="@style/PinPadKey"
            android:text="@string/seven" />

        <TextView
            android:id="@+id/key_8"
            style="@style/PinPadKey"
            android:text="@string/eight" />

        <TextView
            android:id="@+id/key_9"
            style="@style/PinPadKey"
            android:text="@string/nine" />
        <!--  Row 4  -->
        <ImageButton
            android:id="@+id/key_backspace"
            style="@style/PinPadKey.ActionButton"
            android:src="@drawable/outline_backspace_24"
            android:contentDescription="@string/backspace_key_content_description" />

        <TextView
            android:id="@+id/key_0"
            style="@style/PinPadKey"
            android:text="@string/zero" />

        <ImageButton
            android:id="@+id/key_confirm"
            style="@style/PinPadKey.ActionButton"
            android:src="@drawable/outline_check_24"
            android:contentDescription="@string/confirm_key_content_description" />
    </GridLayout>
</merge>
