    <string name="protected_apps_category" msgid="1304801071926013713">"எனது ஆப்ஸ்"</string>
    <string name="legal_notice_summary" msgid="964477552334840080">"ஆப்ஸ் பூட்டு பயனர் இடைமுகத்தை மட்டுமே முடக்கும் என்பதால், பிற ஆப்ஸுடன் தரவைப் பகிர்வது (எ.கா. படங்கள் அல்லது ஃபைல்கள்) உட்பட பின்புலத்தில் ஆப்ஸ் தொடர்ந்து இயங்கிக் கொண்டிருக்கக்கூடும். அத்துடன், பூட்டப்பட்ட ஆப்ஸின் கணக்கைப் பகிரக்கூடிய புதிய ஆப்ஸை யாரேனும் நிறுவினால் அவர்கள் தானாகவே அந்தக் கணக்கில் உள்நுழையக்கூடும். இதனால் வாகனத்தில் உங்கள் தரவு வெளிப்படக்கூடிய சாத்தியமுள்ளது."</string>
    <string name="validate_pin_title" msgid="2053218844267207153">"உங்கள் பின்னை டைப் செய்யுங்கள்"</string>
