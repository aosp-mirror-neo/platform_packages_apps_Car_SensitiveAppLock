    <string name="setting_title" msgid="7121031924096985436">"ஆப்ஸ் பூட்டு"</string>
    <string name="setting_summary" msgid="6570520942958337147">"ஆப்ஸைப் பூட்டுவதன் மூலம் பிறர் அவற்றைத் திறப்பதைத் தடுக்கலாம்"</string>
