<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pin_nav_graph"
    app:startDestination="@id/create_pin">
    <fragment
        android:id="@+id/validate_pin"
        android:name="com.android.car.sensitiveapplock.lockscreen.ValidatePinFragment"
        android:label="Validate Pin">
    </fragment>
    <fragment
        android:id="@+id/create_pin"
        android:name="com.android.car.sensitiveapplock.lockscreen.CreatePinFragment"
        android:label="Create Pin">
        <!-- Action to navigate from Create Pin to Confirm Pin. -->
        <action
            android:id="@+id/action_create_pin_to_confirm_pin"
            app:destination="@id/confirm_pin" />
        <!-- Action to navigate from Create Pin to Validate Pin. -->
        <action
            android:id="@+id/action_create_pin_to_validate_pin"
            app:destination="@id/validate_pin" />
    </fragment>
    <fragment
        android:id="@+id/confirm_pin"
        android:name="com.android.car.sensitiveapplock.lockscreen.ConfirmPinFragment"
        android:label="Confirm Pin">
        <!-- Action to navigate from Confirm Pin to Create Pin. -->
        <action
            android:id="@+id/action_confirm_pin_to_create_pin"
            app:destination="@id/create_pin" />
    </fragment>
</navigation>
